# Server-only secrets. NEVER use the VITE_ prefix for these.
# Generate a long random value (32+ characters).
BETTER_AUTH_SECRET=replace-with-a-random-32-plus-character-secret

# MongoDB Atlas connection string.
# Example:
# mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
BETTER_AUTH_DB_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Production canonical URL. For example:
# https://your-domain.com
# For a Vercel-only deployment you may use the project's production URL.
# Optional on Vercel (auto-detected). Set to your custom domain if you use one.
# Locally keep http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173

# Optional: comma-separated additional hostnames, without http:// or https://.
# Example: app.example.com,www.example.com
BETTER_AUTH_ALLOWED_HOSTS=

# Optional Google OAuth. Email/password auth works without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
