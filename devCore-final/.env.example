# Server-only. Never expose these with the VITE_ prefix.
BETTER_AUTH_SECRET=replace-with-a-random-32-plus-character-secret
BETTER_AUTH_DB_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Production base URL. For Vercel previews, Better Auth also accepts *.vercel.app.
BETTER_AUTH_URL=http://localhost:3000

# Optional comma-separated custom hosts, e.g. devcore.example.com,www.devcore.example.com
BETTER_AUTH_ALLOWED_HOSTS=
